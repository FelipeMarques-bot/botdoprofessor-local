SECRET_KEY=change-this-to-a-random-string-in-production
DATABASE_URL=sqlite:///data/bot_local.db

# URLs
APP_URL=http://localhost:5000

# Mercado Pago
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=

# Pix (fallback manual)
PIX_KEY=sua-chave-pix@email.com
PIX_NAME=BotDoProfessor
PIX_CITY=Sao Paulo

# Email (envio de licenças)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# Contato do cliente
CONTACT_EMAIL=contato@botdoprofessor.com.br

# Storage do binario (Cloudflare R2 / S3-compatible) - download protegido
# Crie um bucket PRIVADO no R2 e gere uma API Token (Access Key ID + Secret).
# Envie o .exe ao bucket com: python upload_binario.py
STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=botdoprofessor-binarios
STORAGE_OBJECT=BotDoProfessor.exe
STORAGE_REGION=auto
DOWNLOAD_URL_TTL=600

# AI Provider: gemini, openai, anthropic, ollama, local
AI_PROVIDER=local
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Encryption key (auto-generated if empty)
ENCRYPTION_KEY=
